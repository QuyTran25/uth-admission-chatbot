# UTH Admission Chatbot — Environment Variables
# Copy file này thành .env và điền giá trị thật

# === Gemini API ===
# Lấy key miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Model đã được kiểm tra với Google GenAI API. Có thể ghi đè trong .env.
GEMINI_MODEL=models/gemini-3.6-flash
# Các model dự phòng, phân tách bằng dấu phẩy. Dùng khi model chính trả lỗi 429/5xx.
GEMINI_FALLBACK_MODELS=models/gemini-3.5-flash,models/gemini-3.5-flash-lite
GEMINI_MAX_RETRIES=5
GEMINI_RETRY_BASE_DELAY_SECONDS=2.0

# === Embedding Model ===
EMBED_MODEL=bkai-foundation-models/vietnamese-bi-encoder
WORD_SEGMENTATION=true

# === Index ===
INDEX_DIR=backend/data/index

# === Retrieval ===
TOP_K_DEFAULT=5
DEFAULT_ADMISSION_YEAR=2026
BM25_WEIGHT=0.4
DENSE_WEIGHT=0.6
RRF_K=60
